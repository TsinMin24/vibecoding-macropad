/*
 * ZMK Keymap Configuration
 * Nice Nano - 2x5 Layout for Vibe Coding
 *
 * Layout:
 *   Row 1: F5   F13  F14  F15  F16
 *   Row 2: F17  F18  F19  F20  Enter
 *   Row 3: Delete
 */

/ {
    chosen {
        zmk,keymap = &default_layer;
    };

    default_layer: keymap {
        compatible = "zmk,keymap";

        // 2x5 matrix layout - Vibe Coding optimized
        default_layer {
            bindings = [
                &kp F5  &kp F13 &kp F14 &kp F15 &kp F16
                &kp F17 &kp F18 &kp F19 &kp F20 &kp RET
                &kp DEL  &none   &none   &none   &none
            ];
        };
    };
};
