#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * nice!nano v2 2x5 keymap
 * 与 config/nice_nano.keymap 相同，v2 板单独命名。
 */

/ {
    chosen {
        zmk,keymap = &default_layer;
    };

    default_layer: keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp F5  &kp F13 &kp F14 &kp F15 &kp F16
                &kp F17 &kp F18 &kp F19 &kp F20 &kp RET
                &kp DEL  &bt BT_CLR_ALL  &none   &none   &none
            >;
        };
    };
};
